#!/usr/bin/env bash
# swarm-fleet -- process supervision for the runners.
#
# Ported from internal/swarm-admiral/bin/swarm-fleet. That file was 641 lines and appeared in NO
# planning document for this program: three coverage audits found that nobody owned process
# supervision. It is owned here.
#
# tmux is the supervisor: one session named `swarm`, one window per agent, one runner loop per
# window. That is deliberately boring. The interesting part is the four reconciliation rules,
# each of which exists because its absence corrupted something:
#
#   up       REFUSES to start a name that is already heartbeating. Two runners under one name
#            both heartbeat as that name, so `reap` sees a live agent and never requeues the
#            dead one's task. Not recoverable by hand once it happens.
#   down     writes an `offline` heartbeat for every window it kills, because tmux tears panes
#            down with SIGHUP and a killed runner's own trap may not get to run. Without it
#            `status` reports ghosts forever. It also SWEEPS ORPHAN ENGINES, because a headless
#            engine outlives its runner and keeps billing against a store nobody is watching.
#   status   reconciles three sources -- config, tmux and heartbeats -- and names the
#            disagreements. A name in config with no window and a live heartbeat is a different
#            problem from one with a window and no heartbeat.
#   restart  fails the held task IMMEDIATELY rather than waiting out reap's stale window.
#
# ONE CHANGE from the original, marked INCIDENT: `restart` releases conditionally.

set -uo pipefail

# NOT `swarm`. That is the tmux session the LIVE swarm-admiral fleet runs in on this host, and
# `swarm-fleet down` kills its session by name -- pointing this at `swarm` would have let a test
# run of this file tear down the running fleet, including the terminal executing it. Caught by
# running `status` and seeing it reconcile against T1..T6 windows that belong to the other
# system. The two supervisors must never share a session name while both exist.
SESSION="${SWARM_FLEET_SESSION:-swarm-runtime}"
LIVE_SECONDS="${SWARM_FLEET_LIVE_SECONDS:-180}"

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *)  SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
REPO="$(dirname "$(dirname "$SELF")")"
SWARM="$HERE/swarm"
RUNNER="$HERE/swarm-run"
STATE_DIR="${ENGINE_HOME:-$HOME/.brain-runtime}"

die()  { printf 'swarm-fleet: %s\n' "$*" >&2; exit 1; }
note() { printf '%s\n' "$*"; }

require_tmux() {
  command -v tmux >/dev/null 2>&1 && return 0
  die "tmux is not installed and this command needs it to hold the runner loops.
  Install it:   sudo apt install tmux
  Or run one runner by hand:   $RUNNER <agent>
  Doing that by hand is supported, and the accepted risk is written down in
  engine/SUPERVISION.md: nothing then enforces the one-runner-per-name rule."
}

# POSIX-safe single quoting, because tmux hands the command string to `sh -c`.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

agents_all() {
  "$SWARM" config --json 2>/dev/null | python3 -c "
import json,sys
try: print('\n'.join(json.load(sys.stdin).get('agents') or []))
except Exception: pass"
}

agent_known() {
  local a want="$1"
  while read -r a; do [ "$a" = "$want" ] && return 0; done < <(agents_all)
  return 1
}

# name<TAB>status<TAB>silent-seconds<TAB>task, one line per agent, from the store.
hb_table() {
  "$SWARM" status --json 2>/dev/null | python3 -c "
import json,sys
try: d = json.load(sys.stdin)
except Exception: raise SystemExit
for a in d.get('agents') or []:
    print('\t'.join([a.get('name',''), a.get('status',''), str(a.get('silent') if a.get('silent') is not None else -1),
                     a.get('work_item_id') or '']))"
}

hb_field() {
  printf '%s\n' "$1" | awk -F'\t' -v n="$2" -v c="$3" '$1 == n {print $(c + 1)}'
}

# ---------------------------------------------------------------------- tmux
session_exists() { tmux has-session -t "=$SESSION" 2>/dev/null; }
windows() { tmux list-windows -t "=$SESSION" -F '#{window_name}' 2>/dev/null; }
window_exists() {
  local w
  while read -r w; do [ "$w" = "$1" ] && return 0; done < <(windows)
  return 1
}

start_window() {
  local agent="$1" cmd
  cmd="while :; do $(q "$RUNNER") $(q "$agent"); sleep 5; done"
  if session_exists; then
    tmux new-window -d -t "=$SESSION" -n "$agent" "$cmd" || return 1
  else
    tmux new-session -d -s "$SESSION" -n "$agent" "$cmd" || return 1
    tmux set-environment -t "=$SESSION" ENGINE_HOME "$STATE_DIR" 2>/dev/null
    tmux set-environment -t "=$SESSION" BRAIN_PG_DB "${BRAIN_PG_DB:-brain}" 2>/dev/null
  fi
  # Without this tmux renames the window after whatever the loop is running, and every window
  # ends up called `python3` a minute later.
  tmux set-window-option -t "=$SESSION:$agent" automatic-rename off >/dev/null 2>&1
  return 0
}

# ------------------------------------------------------------------------ up
cmd_up() {
  require_tmux
  local requested=("$@")
  if [ "${#requested[@]}" -eq 0 ]; then
    mapfile -t requested < <(agents_all)
  fi
  [ "${#requested[@]}" -gt 0 ] || die "no agents in $("$SWARM" config --json >/dev/null 2>&1; echo config)"

  local a
  for a in "${requested[@]}"; do
    agent_known "$a" || die "no agent '$a' in config (known: $(agents_all | paste -sd, -))"
  done

  if "$SWARM" paused >/dev/null 2>&1; then
    note "note: the fleet is paused, so the runners will start and immediately idle."
    note "      Clear it with: swarm resume"
  fi

  local table started=() running=() held=() status silent
  table="$(hb_table)"

  for a in "${requested[@]}"; do
    if window_exists "$a"; then
      running+=("$a")
      continue
    fi
    # THE GUARD. No window here, but something is still heartbeating as this name: a systemd
    # unit, a nohup, or another machine. Starting a second one is the corruption case.
    status="$(hb_field "$table" "$a" 1)"
    silent="$(hb_field "$table" "$a" 2)"
    if [ -n "$status" ] && [ "$status" != "offline" ] && [ -n "$silent" ] \
       && [ "$silent" -ge 0 ] 2>/dev/null && [ "$silent" -le "$LIVE_SECONDS" ]; then
      held+=("$a ($status, ${silent}s ago)")
      continue
    fi
    # `start` is a RELEASE, not a precondition: since task 0253 it exits 2 when the agent was
    # not stopped, which on a normal `up` is every agent. Its exit says whether a stop was
    # lifted, and `up` does not care -- what `up` needs is the window, so only `start_window`
    # decides this branch.
    "$SWARM" start --agent "$a" >/dev/null 2>&1 || true
    if start_window "$a"; then
      started+=("$a")
    else
      note "failed to start $a"
    fi
  done

  note ""
  note "session: $SESSION"
  [ "${#started[@]}" -gt 0 ] && note "  started:        ${started[*]}"
  [ "${#running[@]}" -gt 0 ] && note "  already up:     ${running[*]}"
  if [ "${#held[@]}" -gt 0 ]; then
    note "  NOT started:    ${held[*]}"
    note ""
    note "  Those names have no window in this session but are still heartbeating, so either a"
    note "  runner is alive elsewhere (systemd, nohup, another host) or one just died."
    note "  Starting a second runner under the same name is NOT recoverable by hand: both"
    note "  heartbeat as that name, so 'swarm reap' believes a dead agent's task is still being"
    note "  worked and never requeues it. Decide which case it is:"
    note "      swarm-fleet restart <name>     it died here, take the name back"
    note "      swarm stop --agent <name>      it lives elsewhere, make that one idle first"
  fi
  note ""
  note "  NOTE: this guard covers TWO RUNNERS UNDER ONE NAME. It does not cover two DIFFERENT"
  note "  agents holding one task, which is what actually happened on 2026-08-16. For that,"
  note "  see 'swarm doctor', which reports it as a CRITICAL."
  note ""
  note "  swarm-fleet status   reconcile config, tmux and heartbeats"
  note "  swarm-fleet attach   watch them work"
  return 0
}

# ---------------------------------------------------------------------- down
cmd_down() {
  local force=0 all=0 timeout="${SWARM_FLEET_DRAIN:-600}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --all)   all=1 ;;
      --timeout) shift; timeout="${1:-600}" ;;
      *) die "usage: swarm-fleet down [--force] [--all] [--timeout N]" ;;
    esac
    shift
  done

  # Pause first, so nothing claims a new task while we are draining.
  #
  # THE REASON IS NOT DECORATION AND IT IS NOT OPTIONAL. `swarm stop --reason` became required in
  # task 0273 because a stop nobody signed reads on the board exactly like an agent that died, and
  # on 2026-08-19 an admiral read one as the other and reversed a commander's decision three
  # minutes after it was taken. This call site is the one that would have been silently caught by
  # that change: it redirects both streams to /dev/null, so a `stop` refused for want of a reason
  # would have stopped nothing, printed nothing, and let `down` go on to kill the windows anyway.
  local here down_reason
  here="$(hostname 2>/dev/null || echo 'this host')"
  down_reason="swarm-fleet down on $here: draining this host's runners"
  if [ "$all" -eq 1 ]; then
    "$SWARM" pause --by "swarm-fleet" --reason "swarm-fleet down --all on $here" >/dev/null 2>&1
  else
    local a
    while read -r a; do
      [ -n "$a" ] && window_exists "$a" && "$SWARM" stop --agent "$a" --by "swarm-fleet" \
        --reason "$down_reason" >/dev/null 2>&1
    done < <(agents_all)
  fi

  if ! command -v tmux >/dev/null 2>&1 || ! session_exists; then
    note "no tmux session '$SESSION' on this host, so there was nothing of its own to stop."
    [ "$all" -eq 1 ] && note "The fleet is paused, so any runner started outside tmux will idle."
    return 0
  fi

  if [ "$force" -eq 0 ]; then
    local waited=0 drained=0 working
    while [ "$waited" -lt "$timeout" ]; do
      working="$(hb_table | awk -F'\t' '$2 == "working" {printf "%s ", $1}')"
      if [ -z "${working// /}" ]; then drained=1; break; fi
      [ "$waited" -eq 0 ] && note "waiting for in-flight tasks (timeout ${timeout}s, --force to skip)"
      note "  still working: $working"
      sleep 5
      waited=$((waited + 5))
    done
    if [ "$waited" -eq 0 ]; then
      note "no agent is mid-task"
    elif [ "$drained" -eq 1 ]; then
      note "in-flight tasks finished after ${waited}s"
    else
      note "timeout after ${timeout}s, still working: ${working:-?}"
      note "killing anyway. Requeue what they were holding with: swarm reap --stale-seconds 60 --yes"
    fi
  fi

  local stopped=()
  mapfile -t stopped < <(windows)
  tmux kill-session -t "=$SESSION" 2>/dev/null

  # tmux kills panes with SIGHUP. The runner traps it, but a runner that was between commands,
  # or one killed harder, never writes its final `offline`. Write it here or `status` reports
  # ghosts forever and the `up` guard above refuses to restart its own fleet.
  local a
  for a in "${stopped[@]}"; do
    [ -n "$a" ] && "$SWARM" heartbeat --agent "$a" --status offline >/dev/null 2>&1
  done

  note "session '$SESSION' killed: ${stopped[*]:-none}"

  # A headless engine outlives its runner and keeps billing against a store nobody is watching.
  # The runner kills its own engine on the trap; sweep for stragglers anyway. Matched on
  # `--add-dir $STATE_DIR`, which is the flag the runner passes and which is unique to this
  # fleet's engines.
  local stragglers
  stragglers="$(pgrep -f -- "--add-dir $STATE_DIR" 2>/dev/null | tr '\n' ' ')"
  if [ -n "${stragglers// /}" ]; then
    note "killing engine processes that outlived their runner: $stragglers"
    # shellcheck disable=SC2086
    kill -TERM $stragglers 2>/dev/null
    sleep 2
    # shellcheck disable=SC2086
    kill -KILL $stragglers 2>/dev/null
  fi

  if [ "$all" -eq 1 ]; then
    note "The fleet is still paused, on purpose, so nothing restarts by accident."
    note "  swarm resume        clear it"
    note "  swarm-fleet up      bring this host's fleet back"
  else
    note "This host's agents are stopped."
    note "  swarm-fleet up      clear the stops and bring them back"
  fi
  return 0
}

# -------------------------------------------------------------------- status
cmd_status() {
  "$SWARM" status
  note ""
  note "config / tmux / heartbeat, reconciled three ways:"
  printf '  %-12s %-7s %-10s %-8s %s\n' AGENT WINDOW STATUS SILENT FINDING

  local table a status silent task win finding
  table="$(hb_table)"
  local have_tmux=0
  command -v tmux >/dev/null 2>&1 && session_exists && have_tmux=1

  while read -r a; do
    [ -n "$a" ] || continue
    status="$(hb_field "$table" "$a" 1)"
    silent="$(hb_field "$table" "$a" 2)"
    task="$(hb_field "$table" "$a" 3)"
    win=no; [ "$have_tmux" -eq 1 ] && window_exists "$a" && win=yes
    finding=""
    if [ "$win" = no ] && [ -n "$status" ] && [ "$status" != offline ] \
       && [ -n "$silent" ] && [ "$silent" -ge 0 ] 2>/dev/null && [ "$silent" -le "$LIVE_SECONDS" ]; then
      finding="MISMATCH: heartbeating with no window here"
    elif [ "$win" = yes ] && { [ -z "$status" ] || [ "$status" = offline ]; }; then
      finding="MISMATCH: window is up but not heartbeating"
    elif [ "$win" = yes ] && [ -n "$silent" ] && [ "$silent" -gt "$LIVE_SECONDS" ] 2>/dev/null; then
      finding="DIED: window up, silent ${silent}s${task:+, still holding $task}"
    elif [ "$win" = no ] && [ -n "$task" ]; then
      finding="holds $task with no runner: swarm reap --yes"
    fi
    printf '  %-12s %-7s %-10s %-8s %s\n' "$a" "$win" "${status:--}" "${silent:--}" "$finding"
  done < <(agents_all)

  # A window whose name is in no config is the other direction of the same question.
  if [ "$have_tmux" -eq 1 ]; then
    local w
    while read -r w; do
      [ -n "$w" ] || continue
      agent_known "$w" || printf '  %-12s %-7s %-10s %-8s %s\n' "$w" yes - - "window for an agent not in config"
    done < <(windows)
  fi

  note ""
  note "MISMATCH means the name is heartbeating with no window in this session: either the"
  note "runner died just now, or it was started outside tmux (systemd, nohup, another host)."
  note "DIED means it stopped heartbeating too. Either way, work it was holding is still active"
  note "until you requeue it:  swarm reap --yes"
  return 0
}

# -------------------------------------------------------------------- attach
cmd_attach() {
  require_tmux
  local agent="${1:-}"
  session_exists || die "no tmux session '$SESSION'. Start it with: swarm-fleet up"
  local target="=$SESSION"
  if [ -n "$agent" ]; then
    window_exists "$agent" || die "no window '$agent' (windows: $(windows | paste -sd, -))"
    tmux select-window -t "=$SESSION:$agent" || true
    target="=$SESSION:$agent"
  fi
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$target"; else tmux attach-session -t "$target"; fi
}

# ------------------------------------------------------------------- restart
cmd_restart() {
  require_tmux
  local agent="${1:-}"
  [ -n "$agent" ] || die "usage: swarm-fleet restart <agent>"
  agent_known "$agent" || die "no agent '$agent' in config"

  local table task state
  table="$(hb_table)"
  task="$(hb_field "$table" "$agent" 3)"

  if window_exists "$agent"; then
    tmux kill-window -t "=$SESSION:$agent" 2>/dev/null
    note "killed window $SESSION:$agent"
    # Killing mid-task leaves the task active, owned by an agent that no longer exists. Deal
    # with it NOW rather than waiting out reap's stale window.
    if [ -n "$task" ]; then
      state="$("$SWARM" state "$task" 2>/dev/null)"
      if [ "$state" = "active" ]; then
        # INCIDENT 2026-08-16. The original called `fail`, unconditionally. Two problems: it
        # spent an attempt on a task whose agent the OPERATOR killed, and it released the task
        # whoever the store said held it. `release` is conditional on claimed_by and spends
        # nothing. If another agent legitimately holds it, this reports and leaves it alone.
        "$SWARM" release "$task" --agent "$agent" \
          --reason "runner $agent restarted by the operator mid-task" || \
          note "  $task was NOT released: the store says someone else holds it. Left alone."
      fi
    fi
  else
    note "no window $SESSION:$agent was running"
  fi
  "$SWARM" heartbeat --agent "$agent" --status offline >/dev/null 2>&1
  "$SWARM" start --agent "$agent" >/dev/null 2>&1 || true   # exits 2 if it was not stopped
  start_window "$agent" && note "restarted $agent" || die "failed to restart $agent"
  return 0
}

case "${1:-}" in
  up)      shift; cmd_up "$@" ;;
  down)    shift; cmd_down "$@" ;;
  status)  shift; cmd_status "$@" ;;
  attach)  shift; cmd_attach "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  *) cat <<EOF
swarm-fleet -- process supervision for the runners

  swarm-fleet up [agent...]        start runners in tmux session '$SESSION'
  swarm-fleet down [--force] [--all] [--timeout N]
                                  drain, stop, write offline heartbeats, sweep orphan engines
  swarm-fleet status              reconcile config, tmux and heartbeats three ways
  swarm-fleet attach [agent]      watch them work
  swarm-fleet restart <agent>     take a name back after its runner died

The one rule worth knowing: 'up' refuses to start a name that is already heartbeating. Two
runners under one name is not recoverable by hand.
EOF
    exit 1 ;;
esac
